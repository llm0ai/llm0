# ── Environment files ─────────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.back
.env.dev
.env.prod
# Keep the example file
!.env.example

# ── Go build artifacts ────────────────────────────────────────────────────────
# Root-level binaries only. The ! rules ensure a future llm0/ or gateway/
# source directory at repo root would still be trackable.
/llm0
!/llm0/
!/llm0/**
/gateway
!/gateway/
!/gateway/**
*.exe

# ── Python (embedding_service/) ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── IDE ───────────────────────────────────────────────────────────────────────
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Go modules (don't vendor) ─────────────────────────────────────────────────
vendor/

.cursor/

# ── Private / internal docs ───────────────────────────────────────────────────
ROADMAP_INTERNAL.md
*_INTERNAL.md