# ── Required: LLM Provider API Keys ─────────────────────────────────────────
# Add at least one. The gateway will route to whichever providers have keys set.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ── Required: Infrastructure ─────────────────────────────────────────────────
DATABASE_URL=postgres://llm0:llm0_password@localhost:5432/llm0_gateway?sslmode=disable
REDIS_URL=redis://localhost:6379

# ── Optional: Server ─────────────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=local   # local | production

# ── Optional: Admin API (control plane) ──────────────────────────────────────
# CRUD over projects/api-keys — see internal/gateway/admin/ and
# plans/managed/06-milestones-and-roadmap.md (M0). Runs on its OWN port,
# separate from PORT above, so it can be firewalled off from the public
# internet independently. Leave ADMIN_TOKEN empty to disable it entirely
# (the default — most self-hosters manage the gateway via scripts/*.sh and
# never need this).
#
# ⚠️  In production, ADMIN_LISTEN_ADDR must be reachable ONLY from a
# trusted internal network (Fly 6PN, a Docker-internal network, etc.) —
# never expose it to the public internet, token or no token.
ADMIN_TOKEN=
ADMIN_LISTEN_ADDR=:8081

# ── Optional: Semantic Cache ──────────────────────────────────────────────────
# When using docker compose, this is set automatically to http://embedding:8080.
# For local Go runs (without Docker), start embedding_service/ separately and set:
EMBEDDING_SERVICE_URL=http://localhost:8001

# ── Optional: Ollama (local models) ──────────────────────────────────────────
# Set OLLAMA_BASE_URL to enable local model support.
# If running Ollama on the same machine: http://host.docker.internal:11434/v1
# If running natively (no Docker):       http://localhost:11434/v1
OLLAMA_BASE_URL=

# Tier-to-model mapping — which Ollama model to use per quality tier.
# "flagship" = gpt-4o class, "balanced" = gpt-4o-mini class, "budget" = cheap/fast
OLLAMA_MODEL_FLAGSHIP=llama3.3:70b
OLLAMA_MODEL_BALANCED=qwen2.5:14b
OLLAMA_MODEL_BUDGET=gemma3:4b

# Drop empty role-only SSE chunks from Ollama streams (default: true).
# Set to false for raw byte-for-byte Ollama output.
OLLAMA_FILTER_EMPTY_CHUNKS=true

# ── Optional: Failover mode ───────────────────────────────────────────────────
# Controls how cloud and local (Ollama) providers are ordered in the failover chain.
#   cloud_first  — try cloud first, fall back to Ollama   (default)
#   local_first  — try Ollama first, fall back to cloud
#   local_only   — only use Ollama, never call cloud APIs
#   cloud_only   — only use cloud providers (Ollama ignored even if configured)
FAILOVER_MODE=cloud_first

# ── Optional: Cross-provider failover defaults ────────────────────────────────
# When a request fails over to a DIFFERENT provider (e.g. OpenAI -> Anthropic),
# which model on that provider should it use? Every model is classified as
# "flagship" or "cheap" from its name (haiku/mini/flash/etc. -> cheap), so a
# cheap request never accidentally fails over into an expensive model.
# Bump these when a new model generation ships — that's the only maintenance
# this requires; no per-model chain to hand-edit. The values below are
# conservative, widely-available picks verified to work; the code defaults
# in internal/shared/config/config.go point at newer/pricier model names —
# override with whatever your provider accounts actually have access to.
FAILOVER_OPENAI_FLAGSHIP=gpt-4o
FAILOVER_OPENAI_CHEAP=gpt-4o-mini
FAILOVER_ANTHROPIC_FLAGSHIP=claude-sonnet-4-5-20250929
FAILOVER_ANTHROPIC_CHEAP=claude-haiku-4-5-20251001
FAILOVER_GOOGLE_FLAGSHIP=gemini-2.5-pro
FAILOVER_GOOGLE_CHEAP=gemini-2.5-flash

# Preference order for the OTHER providers tried after the origin model's own
# provider. The origin provider is always skipped automatically.
FAILOVER_PROVIDER_ORDER=openai,anthropic,google

# ── Optional: Cache TTL ───────────────────────────────────────────────────────
CACHE_TTL_SECONDS=3600   # 1 hour default
